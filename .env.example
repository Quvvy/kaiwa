# DeepSeek API key — preferred: paste in the first-run UI / Settings → Profiles
# (saved under %LocalAppData%\Kaiwa\secrets.json). Optional for local dev:
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
DEEPSEEK_THINKING=disabled
TTS_ENGINE=aivisspeech
AIVISSPEECH_BASE_URL=http://127.0.0.1:10101
AIVISSPEECH_SPEAKER_ID=888753760
VOICEVOX_BASE_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER_ID=3
WHISPER_MODEL=large-v3-turbo
# auto = CUDA when GPU + nvidia wheels available, else CPU; or cuda | cpu
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=float16
HOST=127.0.0.1
PORT=8787
# Optional: override user data root (default %LocalAppData%\Kaiwa)
# KAIWA_DATA_DIR=
